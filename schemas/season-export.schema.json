{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SGRS SwimPlan Gesamtexport",
  "type": "object",
  "required": [
    "schemaVersion",
    "exportedAt",
    "configurationValues",
    "seasons",
    "eventTracks",
    "events",
    "calendarConstraints",
    "macrocycles",
    "mesocycles",
    "microcycles",
    "microcycleSegments",
    "periodizationDimensions",
    "focusDefinitions",
    "focusSegments",
    "trainingDays",
    "trainingSessions",
    "equipmentItems",
    "sessionEquipment",
    "revisions"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "exportedAt": { "type": "string", "format": "date-time" },
    "configurationValues": {
      "type": "array",
      "items": { "$ref": "#/$defs/versioned" }
    },
    "seasons": {
      "type": "array",
      "items": { "$ref": "#/$defs/versioned" },
      "minItems": 1
    },
    "eventTracks": { "type": "array" },
    "events": { "type": "array" },
    "calendarConstraints": { "type": "array" },
    "macrocycles": { "type": "array" },
    "mesocycles": { "type": "array" },
    "microcycles": { "type": "array" },
    "microcycleSegments": { "type": "array" },
    "periodizationDimensions": { "type": "array" },
    "focusDefinitions": { "type": "array" },
    "focusSegments": { "type": "array" },
    "trainingDays": { "type": "array" },
    "trainingSessions": { "type": "array" },
    "equipmentItems": { "type": "array" },
    "sessionEquipment": { "type": "array" },
    "revisions": { "type": "array" }
  },
  "$defs": {
    "versioned": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 0 },
        "deletedAt": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
